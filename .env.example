# Gercek degerleri sohbete veya Git'e eklemeyin.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Supabase Connect > Transaction pooler (6543), parola URL-encoded olmali.
DATABASE_URL=
# Supabase Connect > Session pooler (5432).
DATABASE_MIGRATION_URL=
# Misafir oy kimligi HMAC anahtari; en az 32 karakter. Oturumlar arasinda koruyun.
GUEST_VOTE_HASH_KEY=
# Istege bagli test yonetim baglantisi: test DB olusturabilen dogrudan PostgreSQL URI.
# Bosken Supabase session pooler adresinden ayni projenin direct adresi turetilir.
DATABASE_TEST_ADMIN_URL=
# Production (DJANGO_DEBUG=false): sslmode=verify-full zorunlu.
# Guvenilir CA dosyasinin calisan ortamdaki yolu; istege bagli libpq ayari.
# URL sslrootcert secenegi varsa bu degiskenin onune gecer.
# PGSSLROOTCERT=C:/certs/provider-root.crt

